---
import { site, products, work, services } from '../data/site';

const title = `${site.name} — lab produk & software independen`;
const ogImage = new URL('og.png', Astro.site);

const statusLabel: Record<string, string> = {
  shipped: 'rilis',
  beta: 'beta',
  wip: 'dalam pengerjaan',
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap">
      <nav>
        <a href="/" class="brand">lamaau<i>labs</i></a>
        <div class="nav-right">
          <ul>
            <li><a href="#produk">Produk</a></li>
            <li><a href="#proyek">Proyek</a></li>
            <li><a href="#layanan">Layanan</a></li>
            <li><a href="#kontak">Kontak</a></li>
          </ul>
          <a href="#kontak" class="status"><span class="dot"></span>terbuka untuk proyek</a>
        </div>
      </nav>

      <section class="hero">
        <div>
          <h1>
            Kita bangun produk<br />
            sendiri. Lalu bantu<br />
            bangun <em>punyamu</em>.
          </h1>
          <p>{site.about}</p>
          <div class="hero-actions">
            <a href="#kontak" class="btn">Mulai proyek <span class="btn-arrow">→</span></a>
            <a href="#produk" class="link-underline">Lihat produk</a>
          </div>
        </div>

        <aside class="engage-panel">
          <div class="engage-title">
            <span>status / studio</span>
            <span><span class="dot"></span>tersedia</span>
          </div>
          <div class="engage-row"><span>lokasi</span><span>{site.location} · remote</span></div>
          <div class="engage-row"><span>model</span><span>scope tetap</span></div>
          <div class="engage-row"><span>cakupan</span><span>web · api · db · deploy</span></div>
          <div class="engage-divider"></div>
          <div class="engage-row"><span>produk sendiri</span><span>{products.length} rilis</span></div>
          <div class="engage-row"><span>proyek klien</span><span>{work.length} terpilih</span></div>
          <div class="engage-divider"></div>
          <p class="engage-note">
            Kami nggak ambil proyek yang nggak jelas scope-nya. Kalau belum ada spec, kita
            mulai dari percakapan singkat dulu.
          </p>
        </aside>
      </section>

      <div class="stats">
        <div class="stat">
          <div class="stat-num">{products.length}</div>
          <div class="stat-label">produk rilis sendiri</div>
        </div>
        <div class="stat">
          <div class="stat-num">{work.length}</div>
          <div class="stat-label">proyek klien terpilih</div>
        </div>
        <div class="stat">
          <div class="stat-num">0</div>
          <div class="stat-label">baris JavaScript di halaman ini</div>
        </div>
        <div class="stat">
          <div class="stat-num">100<em>%</em></div>
          <div class="stat-label">kode diserahkan ke klien</div>
        </div>
      </div>

      <section class="section" id="produk">
        <div class="section-head">
          <div>
            <div class="eyebrow">/ produk</div>
            <h2>Tools yang kami<br />pakai <em>sendiri</em>.</h2>
          </div>
          <p>
            Semuanya lahir dari masalah yang kami alami dulu, lalu kami bangun dan jalankan
            sendiri. Nggak ada yang cuma mockup.
          </p>
        </div>

        <div class="work-grid">
          {products.map((p) => (
            <a href={p.url} class="project">
              <div class="project-meta">
                <span>{p.url.replace(/^https?:\/\//, '')}</span>
                <span>→</span>
              </div>
              <h3>{p.name}</h3>
              <p>{p.line}</p>
              <div class="project-tags">
                <span class="tag">{statusLabel[p.status]}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="section" id="proyek">
        <div class="section-head">
          <div>
            <div class="eyebrow">/ proyek</div>
            <h2>Yang sudah<br />jalan di <em>production</em>.</h2>
          </div>
          <p>
            Sebagian nggak bisa kami sebut namanya. Ini yang boleh disebut, dan semuanya
            masih jalan.
          </p>
        </div>

        <div class="work-grid">
          {work.map((w) => (
            <div class="project">
              <div class="project-meta">
                <span>{w.year}</span>
                <span>{w.client}</span>
              </div>
              <h3>{w.title}</h3>
              <p>{w.why}</p>
              <div class="project-tags">
                {w.kind.split(' · ').map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="section" id="layanan">
        <div class="section-head">
          <div>
            <div class="eyebrow">/ layanan</div>
            <h2>Dari spec kosong<br />sampai <em>deploy</em>.</h2>
          </div>
          <p>
            Nggak semua proyek butuh keempatnya. Kita pilih yang relevan setelah ngobrol,
            bukan setelah kirim proposal 20 halaman.
          </p>
        </div>

        <div class="process-list">
          {services.map((s) => (
            <div class="process-item">
              <span class="process-num">{s.k}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="quote">
        <div class="quote-label">/ prinsip</div>
        <div>
          <blockquote>
            Software yang selesai itu jarang soal teknologi. Biasanya soal
            <em>scope yang jelas</em> dan orang yang berani bilang "ini nggak perlu dibangun".
          </blockquote>
          <div class="quote-attr"><strong>— cara kerja lamaaulabs</strong></div>
        </div>
      </section>

      <section class="cta" id="kontak">
        <h2>Punya brief?<br />Kirim <em>satu paragraf</em>.</h2>
        <div class="cta-side">
          <p>
            Kita balas dengan pertanyaan, bukan proposal. Kalau nggak cocok, kita bilang
            nggak cocok.
          </p>
          <a href={`mailto:${site.email}`} class="btn">Kirim brief <span class="btn-arrow">→</span></a>
        </div>
      </section>

      <footer>
        <a href="/" class="brand">lamaau<i>labs</i></a>
        <ul>
          <li><a href="https://github.com/lamaaulabs">GitHub</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
        <div class="colophon">© {site.year}</div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f1ea;
    --ink: #1a1815;
    --muted: #6b6560;
    --line: #d8d2c7;
    --grid: #efeae0;
    --accent: #c4421a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

  body {
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 100px 100px;
    background-position: -1px -1px;
    background-attachment: fixed;
    color: var(--ink);
    font-family: Inter, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---- nav ---- */
  nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-family: 'Instrument Serif', serif;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
  }
  .brand i { color: var(--accent); font-style: italic; }

  nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
    font-size: 0.88rem;
    font-weight: 500;
  }
  nav a { color: var(--muted); text-decoration: none; transition: color 0.15s; }
  nav a:hover { color: var(--ink); }

  .nav-right { display: flex; gap: 32px; align-items: baseline; }
  nav .status { color: var(--ink); font-weight: 500; }

  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4a9a4a;
    margin-right: 6px;
    vertical-align: middle;
    position: relative;
    top: -1px;
    box-shadow: 0 0 0 3px rgba(74, 154, 74, 0.15);
  }

  /* ---- hero ---- */
  .hero {
    padding: 100px 0 90px;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 80px;
    align-items: start;
    border-bottom: 1px solid var(--line);
  }

  .hero h1 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(2.9rem, 5.6vw, 4.9rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin-bottom: 32px;
  }
  .hero h1 em { font-style: italic; color: var(--accent); }

  .hero p {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 500px;
    margin-bottom: 40px;
  }

  .hero-actions {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 0.9rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    border-radius: 2px;
    font-weight: 500;
    font-size: 0.88rem;
    transition: background 0.15s;
  }
  .btn:hover { background: #000; }

  .btn-arrow { display: inline-block; transition: transform 0.15s; }
  .btn:hover .btn-arrow { transform: translateX(3px); }

  .link-underline {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
    font-weight: 500;
  }

  .engage-panel {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(6px);
    padding: 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .engage-title {
    font-family: Inter, sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .engage-title .dot { box-shadow: 0 0 0 2px rgba(74, 154, 74, 0.15); width: 6px; height: 6px; }

  .engage-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 3px 0;
    color: var(--muted);
  }
  .engage-row span:last-child { color: var(--ink); font-weight: 500; text-align: right; }

  .engage-divider { border-top: 1px dashed var(--line); margin: 14px 0; }

  .engage-note {
    font-family: Inter, sans-serif;
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.5;
    font-style: italic;
  }

  /* ---- stats ---- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    padding: 40px 0 40px 32px;
    border-right: 1px solid var(--line);
  }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: none; }

  .stat-num {
    font-family: 'Instrument Serif', serif;
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .stat-num em { color: var(--accent); font-style: italic; }

  .stat-label { font-size: 0.8rem; color: var(--muted); }

  /* ---- sections ---- */
  .section { padding: 90px 0; border-bottom: 1px solid var(--line); }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    margin-bottom: 64px;
    align-items: end;
  }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .section h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .section h2 em { font-style: italic; }

  .section-head p {
    color: var(--muted);
    font-size: 0.98rem;
    max-width: 420px;
  }

  /* ---- work / product grid ---- */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
  }

  .project {
    padding: 36px 0 40px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .project:nth-child(odd) { padding-right: 48px; border-right: 1px solid var(--line); }
  .project:nth-child(even) { padding-left: 48px; }
  .project:last-child,
  .project:nth-last-child(2):nth-child(odd) { border-bottom: none; }

  .project-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    margin-bottom: 18px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .project h3 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: 1.9rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 14px;
    transition: color 0.15s;
  }
  .project[href]:hover h3 { color: var(--accent); }

  .project p {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
    max-width: 420px;
  }

  .project-tags { margin-top: 20px; display: flex; gap: 8px; flex-wrap: wrap; }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--muted);
  }

  /* ---- process / services ---- */
  .process-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
  }

  .process-item {
    padding: 36px 28px 40px 0;
    border-right: 1px solid var(--line);
  }
  .process-item:last-child { border-right: none; padding-right: 0; }

  .process-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 24px;
    display: block;
  }

  .process-item h3 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.15;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .process-item p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }

  /* ---- quote ---- */
  .quote {
    padding: 100px 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 60px;
  }

  .quote-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    padding-top: 8px;
  }

  blockquote {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 720px;
  }
  blockquote em { color: var(--accent); font-style: italic; }

  .quote-attr {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 32px;
    line-height: 1.4;
  }
  .quote-attr strong { color: var(--ink); font-weight: 500; }

  /* ---- cta ---- */
  .cta {
    padding: 100px 0 120px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: end;
  }

  .cta h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 4.6vw, 3.8rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .cta h2 em { font-style: italic; color: var(--accent); }

  .cta-side { text-align: right; font-size: 0.85rem; color: var(--muted); max-width: 280px; }
  .cta-side .btn { margin-top: 20px; }

  /* ---- footer ---- */
  footer {
    border-top: 1px solid var(--line);
    padding: 32px 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--muted);
    flex-wrap: wrap;
    gap: 20px;
  }
  footer .brand { font-size: 1.1rem; }
  footer ul { display: flex; gap: 28px; list-style: none; flex-wrap: wrap; }
  footer a { color: var(--muted); text-decoration: none; }
  footer a:hover { color: var(--ink); }
  .colophon { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; }

  /* ---- responsive ---- */
  @media (max-width: 900px) {
    nav { flex-wrap: wrap; gap: 14px 28px; }
    .nav-right { flex-wrap: wrap; gap: 14px 24px; }
    nav ul { gap: 20px; font-size: 0.82rem; }

    .hero { grid-template-columns: 1fr; gap: 48px; padding: 64px 0; }

    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(2) { border-right: none; }
    .stat:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .stat:nth-child(3) { padding-left: 0; }

    .section { padding: 64px 0; }
    .section-head { grid-template-columns: 1fr; gap: 24px; margin-bottom: 44px; }

    .work-grid { grid-template-columns: 1fr; }
    .project:nth-child(odd) { padding-right: 0; border-right: none; }
    .project:nth-child(even) { padding-left: 0; }
    .project:nth-last-child(2):nth-child(odd) { border-bottom: 1px solid var(--line); }
    .project:last-child { border-bottom: none; }

    .process-list { grid-template-columns: repeat(2, 1fr); }
    .process-item { border-bottom: 1px solid var(--line); }
    .process-item:nth-child(2n) { border-right: none; padding-right: 0; padding-left: 28px; }
    .process-item:nth-last-child(-n + 2) { border-bottom: none; }

    .quote { grid-template-columns: 1fr; gap: 24px; padding: 64px 0; }
    .cta { grid-template-columns: 1fr; gap: 32px; padding: 64px 0 80px; }
    .cta-side { text-align: left; }
  }

  @media (max-width: 600px) {
    .wrap { padding: 0 20px; }
    nav { padding: 20px 0; }

    .stats { grid-template-columns: 1fr; }
    .stat { border-right: none; border-bottom: 1px solid var(--line); padding: 28px 0; }
    .stat:last-child { border-bottom: none; }

    .hero-actions { flex-direction: column; align-items: flex-start; gap: 16px; }

    .process-list { grid-template-columns: 1fr; }
    .process-item { padding: 32px 0; border-right: none; border-bottom: 1px solid var(--line); }
    .process-item:nth-child(2n) { padding-left: 0; }
    .process-item:nth-last-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .process-item:last-child { border-bottom: none; }
  }
</style>
